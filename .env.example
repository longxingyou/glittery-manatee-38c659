# =====================================================================
# Syntax Garden · 本地开发环境变量示例
# 使用方法：复制本文件为 `.env` 后，把下方占位符改成你的真实取值。
# `.env` 中包含密钥，绝对不要提交到 Git；.gitignore 已自动忽略该文件。
# =====================================================================

# ---------------------------------------------------------------------
# 1) Netlify Database（Drizzle netlify-db 驱动在 server side 强制读取）
# ---------------------------------------------------------------------
# 说明：
#  * 在 Netlify 官网部署环境下：无需手填；Netlify Database 在部署时会自动
#    注入同名环境变量，仅对 SSR Function / Server Function 可见。
#  * 本地开发 / Netlify Dev（`netlify dev`）：请到 Netlify Dashboard
#    → <你的站点> → Netlify Database → "Connect locally" 复制连接串。
#    该 URL 形如：
#    postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require&application_name=netlify-db
#  安全：此串内含密码；只存在于本地 .env，切勿上传到任意公开仓库。
# ---------------------------------------------------------------------
NETLIFY_DB_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB?sslmode=require

# ---------------------------------------------------------------------
# 2) 站点管理员邮箱白名单（管理后台准入的第一道门槛）
# ---------------------------------------------------------------------
# 说明：
#  * 只要登录者（经 Netlify Identity 验证邮箱后）的邮箱出现在下方列表，
#    即可进入 /admin 仪表盘，发布/删除文章、管理分类、上传附件、改设置等。
#  * 允许同时在「站点设置 → 管理员邮箱」后台表单中再追加（两处会合并）；
#    环境变量的优先级用于：还没进过后台 / settings 表为空时提供首个管理员。
#  * 分隔符可用逗号/分号/空格任意组合；大小写不敏感。
#  * 示例：
#       ADMIN_EMAILS="me@example.com, editor@example.cn; partner@example.com"
# ---------------------------------------------------------------------
ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------------
# 3) 其它可选覆盖（按需启用）
# ---------------------------------------------------------------------
# 本地运行 Vite 的端口（默认 3000，已在 netlify.toml dev.targetPort 使用）
# PORT=3000
